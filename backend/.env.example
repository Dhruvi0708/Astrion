# ---- Application ----
ASTRION_ENVIRONMENT=development
ASTRION_LOG_LEVEL=INFO
ASTRION_LOG_JSON=true
# Comma-separated list of browser origins allowed to call the API (credentials are allowed for these).
ASTRION_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- PostgreSQL (application + relational metadata) ----
ASTRION_DATABASE_URL=postgresql+psycopg://astrion:astrion@localhost:5432/astrion

# ---- Authentication ----
# REQUIRED outside development/test: at least 32 random characters, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
ASTRION_JWT_SECRET=
ASTRION_ACCESS_TOKEN_TTL_MINUTES=15
ASTRION_REFRESH_TOKEN_TTL_DAYS=14
# Must be true outside development (cookie only sent over HTTPS).
ASTRION_COOKIE_SECURE=false
ASTRION_LOGIN_MAX_FAILURES=8
ASTRION_LOGIN_WINDOW_SECONDS=900

# ---- Neo4j (knowledge graph). Leave ASTRION_NEO4J_URI empty to run without a graph database. ----
ASTRION_NEO4J_URI=bolt://localhost:7687
ASTRION_NEO4J_USER=neo4j
ASTRION_NEO4J_PASSWORD=change-me
ASTRION_NEO4J_DATABASE=neo4j
ASTRION_NEO4J_TIMEOUT_SECONDS=3
ASTRION_NEO4J_QUERY_TIMEOUT_SECONDS=10

# ---- Document storage ----
ASTRION_STORAGE_BACKEND=local          # local | s3
ASTRION_STORAGE_LOCAL_ROOT=./var/storage
ASTRION_STORAGE_MAX_UPLOAD_MB=50
# S3-compatible storage (when ASTRION_STORAGE_BACKEND=s3). Leave keys empty to use the default AWS credential chain.
ASTRION_S3_BUCKET=
ASTRION_S3_ENDPOINT_URL=
ASTRION_S3_REGION=us-east-1
ASTRION_S3_ACCESS_KEY_ID=
ASTRION_S3_SECRET_ACCESS_KEY=

# ---- AI providers (server-side only; never exposed to the frontend) ----
ANTHROPIC_API_KEY=
ASTRION_LLM_MODEL=claude-opus-5-5
# Optional explicit fallback chain used ONLY after a refusal; every use is recorded. Empty = never fall back.
ASTRION_LLM_FALLBACK_MODELS=
VOYAGE_API_KEY=
ASTRION_EMBEDDING_MODEL=voyage-3.5

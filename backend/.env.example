# ---- Application ----
ASTRION_ENVIRONMENT=development
ASTRION_LOG_LEVEL=INFO
# Comma-separated list of browser origins allowed to call the API.
ASTRION_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- PostgreSQL (application + relational metadata) ----
ASTRION_DATABASE_URL=postgresql+psycopg://astrion:astrion@localhost:5432/astrion

# ---- Neo4j (knowledge graph). Leave NEO4J_URI empty to run without a graph database. ----
ASTRION_NEO4J_URI=bolt://localhost:7687
ASTRION_NEO4J_USER=neo4j
ASTRION_NEO4J_PASSWORD=change-me
ASTRION_NEO4J_DATABASE=neo4j

# ---- AI providers (server-side only; never exposed to the frontend) ----
ANTHROPIC_API_KEY=
ASTRION_LLM_MODEL=claude-opus-5-5
VOYAGE_API_KEY=
ASTRION_EMBEDDING_MODEL=voyage-3.5

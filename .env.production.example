# Copy to .env and fill in every value marked REQUIRED. Never commit the filled-in file (.env is git-ignored).

# ---- Databases (REQUIRED) ----
POSTGRES_USER=astrion
# REQUIRED: long random string
POSTGRES_PASSWORD=
POSTGRES_DB=astrion
# REQUIRED: at least 8 characters
NEO4J_PASSWORD=
NEO4J_HEAP=1G

# ---- API ----
ASTRION_ENVIRONMENT=production
# REQUIRED: >= 32 random characters, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
ASTRION_JWT_SECRET=
# required outside development; browsers accept Secure cookies on https and on localhost
ASTRION_COOKIE_SECURE=true
# the URL users open; same-origin through the web container
ASTRION_CORS_ORIGINS=http://localhost:8080
ASTRION_LOG_LEVEL=INFO
ASTRION_LOGIN_MAX_FAILURES=8
ASTRION_STORAGE_MAX_UPLOAD_MB=50
# ASTRION_STORAGE_BACKEND=s3  (+ ASTRION_S3_BUCKET, ASTRION_S3_REGION, ...) to store files in S3-compatible storage

# ---- AI ----
# REQUIRED for investigations. Without it the API reports "no provider" and refuses to start runs.
ANTHROPIC_API_KEY=
ASTRION_LLM_MODEL=claude-opus-5-5
# never "fixture" in production (the API refuses it)
ASTRION_LLM_PROVIDER=anthropic
ASTRION_RUN_MAX_LLM_CALLS=40
ASTRION_RUN_MAX_TOKENS=2000000
ASTRION_RUN_MAX_COST_USD=20
ASTRION_MAX_CONCURRENT_INVESTIGATIONS=2
ASTRION_MAX_ACTIVE_INVESTIGATIONS_PER_USER=3

# ---- Web ----
ASTRION_WEB_PORT=8080
